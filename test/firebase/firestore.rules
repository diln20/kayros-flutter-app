rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null &&
        request.auth.uid == uid;
    }

    match /paquetes/{uid}/mispaquetes/{packageId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == uid;
    }

    match /notes/{uid}/items/{itemId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == uid;
    }
  }
}
